{
  "name": "Nevazu canonical redirects",
  "description": "Canonical hostname redirects for nevazu.com",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "www_to_apex",
      "description": "Redirect www.nevazu.com to the canonical HTTPS apex, retaining path and query",
      "enabled": true,
      "expression": "(http.host eq \"www.nevazu.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": { "expression": "concat(\"https://nevazu.com\", http.request.uri.path)" },
          "preserve_query_string": true
        }
      }
    }
  ]
}
