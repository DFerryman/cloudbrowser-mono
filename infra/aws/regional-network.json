{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Regional CloudBrowser network. No VMs, NAT gateways, IP allocations or IAM changes. AZs are discovered from AWS APIs.",
  "Parameters": {
    "AzA": {
      "Type": "String",
      "Default": ""
    },
    "AzB": {
      "Type": "String",
      "Default": ""
    },
    "AzC": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "HasA": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AzA"
            },
            ""
          ]
        }
      ]
    },
    "HasB": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AzB"
            },
            ""
          ]
        }
      ]
    },
    "HasC": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AzC"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.40.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser"
          },
          {
            "Key": "cb:network",
            "Value": "true"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser"
          }
        ]
      }
    },
    "Attachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser"
          }
        ]
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "Attachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "BrowserSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "CloudBrowser outbound only; no inbound or SMTP",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 0,
            "ToPort": 24,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 26,
            "ToPort": 464,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 466,
            "ToPort": 586,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 588,
            "ToPort": 65535,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 0,
            "ToPort": 65535,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "icmp",
            "FromPort": -1,
            "ToPort": -1,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser-browser"
          }
        ]
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "HasA",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AzA"
        },
        "CidrBlock": "10.40.0.0/20",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser-A"
          }
        ]
      }
    },
    "AssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "HasA",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "HasB",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AzB"
        },
        "CidrBlock": "10.40.16.0/20",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser-B"
          }
        ]
      }
    },
    "AssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "HasB",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SubnetC": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "HasC",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AzC"
        },
        "CidrBlock": "10.40.32.0/20",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "cloudbrowser-C"
          }
        ]
      }
    },
    "AssociationC": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "HasC",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetC"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    }
  }
}
