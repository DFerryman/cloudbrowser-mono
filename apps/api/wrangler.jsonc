{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudbrowser",
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The web app is served from the same Worker, so /api is same-origin (no CORS).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURN_KEY_ID": "b465a1e4c38bbb6364fb92145ac9170c",
    // Set to your real origin, e.g. https://app.example.com (see docs/deploy-cloudflare.md).
    "APP_URL": "https://nevazu.com",
    "ENVIRONMENT": "production",
    // Must be on a domain onboarded to Cloudflare Email Service (Email Sending).
    "EMAIL_FROM": "no-reply@auth.nevazu.com",
    // Public URL of the session gateway Worker (apps/gateway), e.g. wss://connect.example.com.
    "GATEWAY_URL": "wss://connect.nevazu.com",
    // Billing with Creem (page 6). Off until the API base, the four product ids and the secrets
    // CREEM_API_KEY and CREEM_WEBHOOK_SECRET are all set. Test mode: https://test-api.creem.io
    "CREEM_API_BASE": "",
    "CREEM_PRODUCT_PERSONAL_MONTHLY": "",
    "CREEM_PRODUCT_PERSONAL_YEARLY": "",
    "CREEM_PRODUCT_PRO_MONTHLY": "",
    "CREEM_PRODUCT_PRO_YEARLY": "",
    // Operator console (/admin, page 10): comma-separated IPs and CIDRs allowed to reach it. Empty
    // means nobody (except 127.0.0.1 under `wrangler dev`). Add a WAF rule on the same list.
    "ADMIN_IP_ALLOWLIST": "154.9.249.41,64.83.51.161",
    // Operator alerts: comma-separated emails (via Email Service). The chat webhook URL is the
    // secret ALERT_WEBHOOK_URL (Slack-compatible).
    "ALERT_EMAILS": ""
  },
  // Every 5 minutes: billing sweep (period ends, notices, deletion after 30 days; the 03:00 UTC
  // run also reconciles every subscription with Creem) and delivery of new operator alerts.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Cloudflare Email Service: sign-in codes.
  "send_email": [{ "name": "EMAIL" }],
  // Synchronous calls to the engine (IP checks).
  "services": [{ "binding": "ENGINE", "service": "cloudbrowser-engine" }],
  // Operation dispatch to the engine; Creem webhooks are processed from cloudbrowser-billing.
  "queues": {
    "producers": [
      { "binding": "OPERATIONS", "queue": "cloudbrowser-operations" },
      { "binding": "BILLING", "queue": "cloudbrowser-billing" }
    ],
    "consumers": [{ "queue": "cloudbrowser-billing", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 10 }]
  },
  // Per-user SSE fan-out, hosted by the engine Worker.
  "durable_objects": {
    "bindings": [{ "name": "EVENT_HUB", "class_name": "EventHub", "script_name": "cloudbrowser-engine" }]
  },
  // Workers Rate Limiting (per Cloudflare location; period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrowser",
      // Replace with the id printed by `wrangler d1 create cloudbrowser`.
      "database_id": "c2a603c2-c3d4-409a-83fb-b2e6fac50a7d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
