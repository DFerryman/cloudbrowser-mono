{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudbrowser",
  "workers_dev": true,
  // Keep every public hostname in source control; www is canonicalized by the
  // zone redirect recorded in deploy/cloudflare-www-redirect.json.
  "routes": [
    { "pattern": "nevazu.com", "custom_domain": true },
    { "pattern": "www.nevazu.com", "custom_domain": true },
    { "pattern": "admin.console.nevazu.com", "custom_domain": true }
  ],
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Requests run next to D1's primary (Eastern North America), not at the visitor's edge: a
  // handler's queries follow each other, and from Tokyo each one crossed the Pacific (a heartbeat
  // took 1.1 s there, 0.6 s from Los Angeles). Measured per query: about 10 ms from here (Chicago),
  // 30 ms from Virginia. Only fetch handlers move: the gateway's RPC calls (Internal) and the
  // crons run where they are called. request.cf and CF-Connecting-IP still describe the visitor.
  // Files fetched through the assets binding (/assets/*) are served from here too.
  "placement": { "region": "aws:us-east-2" },
  // The web app is served from the same Worker, so /api is same-origin (no CORS). Every other path
  // is served from the assets without running the Worker: prerendered public pages (x.html at /x,
  // html_handling "auto-trailing-slash"), then index.html for the app's routes. The Worker runs
  // first for the API, for hashed build files (404 rather than the app shell), for the public
  // pages and texts that carry live prices, including / itself (src/site.ts), and for every text
  // file, which the assets binding sends without a charset (the Worker adds it). Patterns match the
  // whole path; * matches anything, slashes included.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*", "/", "/home", "/pricing", "/index.md", "/pricing.md", "/llms.txt", "/llms-full.txt", "/*.md", "/robots.txt"]
  },
  "vars": {
    "TURN_KEY_ID": "b465a1e4c38bbb6364fb92145ac9170c",
    // Set to your real origin, e.g. https://app.example.com (see docs/deploy-cloudflare.md).
    "APP_URL": "https://nevazu.com",
    "ENVIRONMENT": "production",
    // Must be on a domain onboarded to Cloudflare Email Service (Email Sending).
    "EMAIL_FROM": "no-reply@auth.nevazu.com",
    // Cloudflare Turnstile on sign-in and sign-up (secret: TURNSTILE_SECRET_KEY).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFe-qsMj-V1PL5xE",
    // Public URL of the session gateway Worker (apps/gateway), e.g. wss://connect.example.com.
    "GATEWAY_URL": "wss://connect.nevazu.com",
    // Prepaid top-ups (page 6). Stripe takes them when its secrets STRIPE_SECRET_KEY,
    // STRIPE_WEBHOOK_SECRET and STRIPE_TOPUP_PRICES are all valid; never declare them here, since
    // vars in this file override what the dashboard keeps (docs/deploy-cloudflare.md, "3b").
    // Otherwise Creem takes them: off until the API base, the top-up product ids and the
    // secrets CREEM_API_KEY and CREEM_WEBHOOK_SECRET are all set. Test mode: https://test-api.creem.io
    "CREEM_API_BASE": "https://api.creem.io",
    // Comma-separated ids of one-time USD products, one per top-up amount (e.g. $10, $25, $50).
    "CREEM_TOPUP_PRODUCTS": "prod_7g3a6pW1CH1x5TjEUQ2b9A",
    // Independent operator origin, protected by Cloudflare Access email OTP.
    // Keep the Access policy and server-side email allowlist in sync. No IP restriction.
    "ADMIN_URL": "https://admin.console.nevazu.com",
    "ACCESS_TEAM_DOMAIN": "gotagma.cloudflareaccess.com",
    "ACCESS_AUD": "3084001a20212c1625f2aa36fc813d2683597a5d3ebbf52d17a7af45b7968591",
    "ADMIN_EMAIL_ALLOWLIST": "sanchai20@163.com",
    // Operator alerts: comma-separated emails (via Email Service). The chat webhook URL is the
    // secret ALERT_WEBHOOK_URL (Slack-compatible).
    "ALERT_EMAILS": ""
  },
  // Every 5 minutes: billing sweep (webhook retries, notices, deletion seven days after credit
  // runs out; the 03:00 UTC run also re-reads unpaid top-ups from Stripe and Creem) and delivery
  // of new operator alerts.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Cloudflare Email Service: sign-in codes.
  "send_email": [{ "name": "EMAIL" }],
  // Internal calls only: IP checks and immediate connection revocation after browser deletion.
  "services": [
    { "binding": "ENGINE", "service": "cloudbrowser-engine" },
    { "binding": "AWS_PROVIDER", "service": "cloudbrowser-reconciler" },
    { "binding": "GATEWAY", "service": "cloudbrowser-gateway", "entrypoint": "Internal" }
  ],
  // Operation dispatch to the engine; Stripe and Creem webhooks are processed from cloudbrowser-billing.
  "queues": {
    "producers": [
      { "binding": "OPERATIONS", "queue": "cloudbrowser-operations" },
      { "binding": "BILLING", "queue": "cloudbrowser-billing" }
    ],
    "consumers": [{ "queue": "cloudbrowser-billing", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 10 }]
  },
  // Per-user SSE fan-out, hosted by the engine Worker.
  "durable_objects": {
    "bindings": [{ "name": "EVENT_HUB", "class_name": "EventHub", "script_name": "cloudbrowser-engine" }]
  },
  // Workers Rate Limiting (per Cloudflare location; period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrowser",
      // Replace with the id printed by `wrangler d1 create cloudbrowser`.
      "database_id": "c2a603c2-c3d4-409a-83fb-b2e6fac50a7d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
