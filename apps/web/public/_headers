# Security headers for the static app (page 1, "Security"). No third-party scripts or fonts.
# connect-src allows wss: for the session gateway on its own hostname (connect.example.com), and
# each AWS region's ping endpoint (AWS_REGION_FACTS) so the create dialog can measure latency.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss: ws://localhost:* ws://127.0.0.1:* https://dynamodb.us-east-1.amazonaws.com https://dynamodb.us-east-2.amazonaws.com https://dynamodb.us-west-1.amazonaws.com https://dynamodb.us-west-2.amazonaws.com https://dynamodb.ca-central-1.amazonaws.com https://dynamodb.ca-west-1.amazonaws.com https://dynamodb.mx-central-1.amazonaws.com https://dynamodb.sa-east-1.amazonaws.com https://dynamodb.eu-west-1.amazonaws.com https://dynamodb.eu-west-2.amazonaws.com https://dynamodb.eu-west-3.amazonaws.com https://dynamodb.eu-central-1.amazonaws.com https://dynamodb.eu-central-2.amazonaws.com https://dynamodb.eu-north-1.amazonaws.com https://dynamodb.eu-south-1.amazonaws.com https://dynamodb.eu-south-2.amazonaws.com https://dynamodb.il-central-1.amazonaws.com https://dynamodb.me-central-1.amazonaws.com https://dynamodb.me-south-1.amazonaws.com https://dynamodb.af-south-1.amazonaws.com https://dynamodb.ap-east-1.amazonaws.com https://dynamodb.ap-east-2.amazonaws.com https://dynamodb.ap-south-1.amazonaws.com https://dynamodb.ap-south-2.amazonaws.com https://dynamodb.ap-northeast-1.amazonaws.com https://dynamodb.ap-northeast-2.amazonaws.com https://dynamodb.ap-northeast-3.amazonaws.com https://dynamodb.ap-southeast-1.amazonaws.com https://dynamodb.ap-southeast-2.amazonaws.com https://dynamodb.ap-southeast-3.amazonaws.com https://dynamodb.ap-southeast-4.amazonaws.com https://dynamodb.ap-southeast-5.amazonaws.com https://dynamodb.ap-southeast-6.amazonaws.com https://dynamodb.ap-southeast-7.amazonaws.com; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), clipboard-write=(self), keyboard-map=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable
