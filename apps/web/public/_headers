# Security headers for the static app (page 1, "Security"). No third-party scripts or fonts.
# connect-src allows wss: for the session gateway on its own hostname (connect.example.com).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss: ws://localhost:* ws://127.0.0.1:*; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), clipboard-write=(self), keyboard-map=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable
