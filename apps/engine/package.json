{
  "name": "@cloudbrowser/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8788 --persist-to ../../.wrangler/state",
    "typecheck": "tsc -p tsconfig.json",
