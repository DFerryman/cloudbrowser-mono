    "@cloudbrowser/db": "workspace:*",
    "@cloudbrowser/executors": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.1"
  }
}
