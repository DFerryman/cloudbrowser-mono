{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudbrowser-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Internal only: reached by the api through a service binding, never from the internet.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  // Operation dispatch: the api enqueues, this Worker consumes (and re-enqueues deferred ones).
  "queues": {
    "producers": [
      { "binding": "OPERATIONS", "queue": "cloudbrowser-operations" },
      // Pokes the gateway to deliver new agent commands.
      { "binding": "AGENT_COMMANDS", "queue": "cloudbrowser-agent-commands" }
    ],
    "consumers": [{ "queue": "cloudbrowser-operations", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 10 }]
  },
  // Per-user SSE fan-out; the api binds to this class with script_name "cloudbrowser-engine".
  "durable_objects": { "bindings": [{ "name": "EVENT_HUB", "class_name": "EventHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventHub"] }],
  "vars": {
    "ENGINE_MODE": "worker",
    "ENV_NAME": "dev",
    // Written into each VM's user data: the session gateway's public URL.
    "GATEWAY_URL": "ws://localhost:8790",
    "FAKE_DELAY_MS": "700",
    // Profile archives (page 4): the agent uploads to presigned R2 URLs. Archives are off until
    // these are set together with the secrets R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY and
    // ARCHIVE_MASTER_KEY (see docs/deploy-cloudflare.md).
    "R2_ACCOUNT_ID": "",
    "R2_ARCHIVE_BUCKET": "cloudbrowser-archives"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrowser",
      // Replace with the id printed by `wrangler d1 create cloudbrowser` (see docs/deploy-cloudflare.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
