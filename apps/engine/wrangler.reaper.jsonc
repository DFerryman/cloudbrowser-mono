{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Same code as the engine, separate deployment: the only Worker that will hold the provider's
  // delete-capable (reaper) credentials once real executors exist (page 10).
  "name": "cloudbrowser-reaper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  // Lets the reaper's status changes (e.g. purged) reach open dashboards.
  "durable_objects": { "bindings": [{ "name": "EVENT_HUB", "class_name": "EventHub", "script_name": "cloudbrowser-engine" }] },
  "vars": {
    "ENGINE_MODE": "reaper",
    "ENV_NAME": "dev"
  },
  // Deletes expired and purged archives (page 4). Only the reaper deletes.
  "r2_buckets": [{ "binding": "ARCHIVES", "bucket_name": "cloudbrowser-archives" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrowser",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
