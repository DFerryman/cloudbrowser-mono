{
  "name": "@cloudbrowser/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --persist-to ../../.wrangler/state",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy": "node ../../scripts/deploy-api-main.mjs --check && node ../../scripts/deploy-workers.mjs --only cloudbrowser-gateway"
  },
  "dependencies": {
    "@cloudbrowser/contracts": "workspace:*",
    "@cloudbrowser/db": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.1"
  }
}
