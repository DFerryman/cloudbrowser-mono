{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudbrowser-reconciler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "ENV_NAME": "prod" },
  "queues": {
    "producers": [{ "binding": "AWS_PROVIDER_JOBS", "queue": "cloudbrowser-aws-provider" }],
    "consumers": [{ "queue": "cloudbrowser-aws-provider", "max_batch_size": 1, "max_retries": 3, "retry_delay": 300 }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrowser",
      "database_id": "c2a603c2-c3d4-409a-83fb-b2e6fac50a7d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
