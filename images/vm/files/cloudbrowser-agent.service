[Unit]
Description=CloudBrowser agent
After=network-online.target containerd.service cloud-final.service
Wants=network-online.target

[Service]
# The engine writes {instanceId, gatewayUrl, bootstrapToken, generation} as the VM's user data.
ExecStart=/usr/local/bin/cloudbrowser-agent \
  --user-data /var/lib/cloud/instance/user-data.txt \
  --state-dir /data/agent \
  --nft-dir /etc/cloudbrowser/nft \
  --echo https://app.example.com/api/echo/ip
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
