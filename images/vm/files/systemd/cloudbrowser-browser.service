[Unit]
Description=CloudBrowser browser container (neko + Chrome)
Requires=docker.service cloudbrowser-data.service
After=docker.service cloudbrowser-data.service network-online.target nftables.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cloudbrowser/cloudbrowser.env
ExecStartPre=/usr/local/lib/cloudbrowser/cloudbrowser-browser-env
ExecStartPre=-/usr/bin/docker rm -f browser
# Host network: Chrome's traffic leaves with the VM's static IP; the VM firewall restricts the
# browser's user (no private, link-local or metadata addresses). /data/browser holds the profile
# and downloads; the agent's state is not mounted.
# Supervisor needs root and runs Chrome and neko as the unprivileged neko user.
ExecStart=/usr/bin/docker run --rm --name browser --user root --network host --shm-size 2g --cap-add SYS_ADMIN \
  --env-file /run/cloudbrowser/neko.env -v /data/browser:/data ${BROWSER_IMAGE}
ExecStop=/usr/bin/docker stop -t 25 browser
Restart=on-failure
RestartSec=3
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
