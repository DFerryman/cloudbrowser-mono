@@ -0,0 +1,36 @@
+package webrtc
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+func TestPlayoutDelayOnNegotiatedStreams(t *testing.T) {
+	var got *rtp.Header
+	sink := interceptor.RTPWriterFunc(func(header *rtp.Header, _ []byte, _ interceptor.Attributes) (int, error) {
+		got = header
+		return 0, nil
+	})
+	i := &playoutDelayInterceptor{}
+
+	// negotiated: every packet carries min 0, max 0
+	w := i.BindLocalStream(&interceptor.StreamInfo{RTPHeaderExtensions: []interceptor.RTPHeaderExtension{{URI: playoutDelayURI, ID: 5}}}, sink)
+	if _, err := w.Write(&rtp.Header{}, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	if ext := got.GetExtension(5); !bytes.Equal(ext, []byte{0, 0, 0}) {
+		t.Fatalf("extension %v", ext)
+	}
+
+	// not negotiated: packets pass unchanged
+	w = i.BindLocalStream(&interceptor.StreamInfo{}, sink)
+	if _, err := w.Write(&rtp.Header{}, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	if got.Extension {
+		t.Fatalf("extension added to a stream that did not negotiate it")
+	}
+}
