index 0000000..3b56d74
--- /dev/null
+++ b/server/internal/webrtc/playoutdelay.go
@@ -0,0 +1,53 @@
+package webrtc
+
+import (
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+// Every video packet carries the playout-delay header extension with a minimum and maximum of 0,
+// so a viewer shows each frame as soon as it is decoded (Chrome's low-latency renderer).
+//
+// Without it, Chrome holds frames in a jitter buffer sized for smooth playback, and keeps them in
+// step with the audio of the same stream: delay the user feels on every keystroke. Measured with
+// the real viewer through a TURN relay, 1080p page scrolling, median glass-to-glass delay:
+// - clean path, 60 ms round trip, 2 minutes: 178 ms without, 123 ms with. Without, the time from
+//   a frame's arrival to its display grew from 20 to 83 ms; with, it stayed at 6-30 ms.
+// - 2 Mbit/s, 200 ms queue: 323-326 ms without, 150-169 ms with; frozen time the same.
+// - 230 ms round trip with 60 ms of jitter and 1% loss: 276-365 ms without, 246-270 ms with, but
+//   a fifth to a third more time frozen (Chrome's count, 10.5-10.9 s a minute without, 12.7-14.7 s
+//   with): a frame that waits for a resend is no longer hidden behind a longer buffer.
+// A lost packet still holds its frame until it is resent: only the wait for frames that already
+// arrived goes. A viewer that does not offer the extension is unaffected.
+const playoutDelayURI = "http://www.webrtc.org/experiments/rtp-hdrext/playout-delay"
+
+// minimum and maximum delay, 12 bits each in units of 10 ms: both 0
+var playoutDelayZero = []byte{0, 0, 0}
+
+type playoutDelayFactory struct{}
+
+func (playoutDelayFactory) NewInterceptor(_ string) (interceptor.Interceptor, error) {
+	return &playoutDelayInterceptor{}, nil
+}
+
+type playoutDelayInterceptor struct {
+	interceptor.NoOp
+}
+
+func (*playoutDelayInterceptor) BindLocalStream(info *interceptor.StreamInfo, writer interceptor.RTPWriter) interceptor.RTPWriter {
+	var id uint8
+	for _, e := range info.RTPHeaderExtensions {
+		if e.URI == playoutDelayURI {
+			id = uint8(e.ID)
+		}
+	}
+	if id == 0 {
+		return writer
+	}
+	return interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (int, error) {
+		if err := header.SetExtension(id, playoutDelayZero); err != nil {
+			return 0, err
+		}
+		return writer.Write(header, payload, attributes)
+	})
+}
