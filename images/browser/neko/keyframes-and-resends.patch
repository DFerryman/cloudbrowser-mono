diff --git a/server/internal/webrtc/retransmit.go b/server/internal/webrtc/retransmit.go
new file mode 100644
index 0000000..a197e04
--- /dev/null
+++ b/server/internal/webrtc/retransmit.go
@@ -0,0 +1,110 @@
+package webrtc
+
+import (
+	"sync"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+// Resends answering a viewer's NACK may use this share of the stream's own rate over the last
+// second, and at least retransmitMinRate (a still page sends little, yet a loss must be repaired),
+// with retransmitBurst bytes back to back.
+//
+// pion's NACK responder resends every packet a viewer asks for, at once. On a link that has just
+// dropped a burst, the resends (a NACK can list hundreds of packets) overflow it again, are asked
+// for again a round trip later, and the link collapses into retransmissions: measured through a
+// 2.5 Mbit/s bottleneck, no frame was decoded for 20 s. Within the budget a loss is repaired as
+// before; beyond it a resend is skipped, and the viewer asks again or, once the frame is too old,
+// asks for a keyframe instead.
+//
+// A quarter, not half: the viewer steps down to the lowest level (800 kbit/s) on a slow link, and
+// half of it with a 300 kbit/s floor let the stream and its resends reach 1.2 Mbit/s, more than a
+// 1 Mbit/s link carries, so after an overload the picture stayed frozen at that level for 4-16 s.
+// A quarter with a 100 kbit/s floor keeps the lowest level and its resends to 1 Mbit/s at most.
+const (
+	retransmitShare   = 0.25
+	retransmitMinRate = 100_000 / 8 // bytes per second
+	retransmitBurst   = 12_000      // bytes, about ten packets
+	rateWindow        = 500 * time.Millisecond
+)
+
+type retransmitLimiterFactory struct{}
+
+func (retransmitLimiterFactory) NewInterceptor(_ string) (interceptor.Interceptor, error) {
+	return &retransmitLimiter{}, nil
+}
+
+// retransmitLimiter must be registered before the NACK responder: interceptors bound earlier sit
+// closer to the network, so the responder's resends pass through it.
+type retransmitLimiter struct {
+	interceptor.NoOp
+}
+
+func (*retransmitLimiter) BindLocalStream(info *interceptor.StreamInfo, writer interceptor.RTPWriter) interceptor.RTPWriter {
+	budget := &retransmitBudget{ssrc: info.SSRC}
+
+	return interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (int, error) {
+		size := header.MarshalSize() + len(payload)
+		if !budget.allow(header, size, time.Now()) {
+			return size, nil
+		}
+		return writer.Write(header, payload, attributes)
+	})
+}
+
+type retransmitBudget struct {
+	mu   sync.Mutex
+	ssrc uint32
+
+	// newest sequence number sent: a packet not newer than it is a resend
+	started bool
+	highest uint16
+
+	// bytes of new packets in the current and the previous window
+	windowStart   time.Time
+	windowBytes   int
+	previousBytes int
+
+	tokens     float64
+	lastRefill time.Time
+}
+
+func (b *retransmitBudget) allow(header *rtp.Header, size int, now time.Time) bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	if elapsed := now.Sub(b.windowStart); elapsed >= rateWindow {
+		if elapsed >= 2*rateWindow {
+			b.previousBytes = 0
+		} else {
+			b.previousBytes = b.windowBytes
+		}
+		b.windowBytes = 0
+		b.windowStart = now
+	}
+
+	// a resend is either an RTX packet (another SSRC) or a sequence number already sent
+	if header.SSRC == b.ssrc && (!b.started || int16(header.SequenceNumber-b.highest) > 0) {
+		b.started = true
+		b.highest = header.SequenceNumber
+		b.windowBytes += size
+		return true
+	}
+
+	rate := float64(b.previousBytes+b.windowBytes) / (rateWindow + now.Sub(b.windowStart)).Seconds()
+	rate = max(retransmitShare*rate, retransmitMinRate)
+	if b.lastRefill.IsZero() {
+		b.tokens = retransmitBurst
+	} else {
+		b.tokens = min(retransmitBurst, b.tokens+rate*now.Sub(b.lastRefill).Seconds())
+	}
+	b.lastRefill = now
+
+	if b.tokens < float64(size) {
+		return false
+	}
+	b.tokens -= float64(size)
+	return true
+}
diff --git a/server/internal/webrtc/retransmit_test.go b/server/internal/webrtc/retransmit_test.go
new file mode 100644
index 0000000..9a05ee0
--- /dev/null
+++ b/server/internal/webrtc/retransmit_test.go
@@ -0,0 +1,74 @@
+package webrtc
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+)
+
+func TestRetransmitBudget(t *testing.T) {
+	b := &retransmitBudget{ssrc: 1}
+	now := time.Unix(0, 0)
+	packet := func(seq uint16) *rtp.Header { return &rtp.Header{SSRC: 1, SequenceNumber: seq} }
+
+	// one second of new packets at 2 Mbit/s: always sent
+	for seq := uint16(0); seq < 200; seq++ {
+		now = now.Add(5 * time.Millisecond)
+		if !b.allow(packet(seq), 1250, now) {
+			t.Fatalf("new packet %d was not sent", seq)
+		}
+	}
+
+	// a NACK for 100 packets at once: the burst allowance, about ten packets, is resent
+	resent := 0
+	for seq := uint16(50); seq < 150; seq++ {
+		if b.allow(packet(seq), 1250, now) {
+			resent++
+		}
+	}
+	if resent < 8 || resent > 10 {
+		t.Fatalf("resent %d of 100 packets at once, want about ten", resent)
+	}
+
+	// a quarter of the stream's rate (500 kbit/s = 62.5 kB/s) refills it: 100 ms allows another five
+	now = now.Add(100 * time.Millisecond)
+	resent = 0
+	for seq := uint16(50); seq < 150; seq++ {
+		if b.allow(packet(seq), 1250, now) {
+			resent++
+		}
+	}
+	if resent < 4 || resent > 6 {
+		t.Fatalf("resent %d after 100 ms, want about five", resent)
+	}
+
+	// a stream gone still keeps the floor (100 kbit/s = 12.5 kB/s): 120 ms allows one
+	now = now.Add(2 * time.Second)
+	b.allow(packet(50), 1250, now)
+	b.tokens = 0
+	now = now.Add(120 * time.Millisecond)
+	resent = 0
+	for seq := uint16(50); seq < 60; seq++ {
+		if b.allow(packet(seq), 1250, now) {
+			resent++
+		}
+	}
+	if resent != 1 {
+		t.Fatalf("resent %d of a still stream after 120 ms, want one", resent)
+	}
+
+	// new packets are never held back by resends, across the sequence number wrap too
+	b.highest = 65530
+	for seq := uint16(65531); seq != 5; seq++ {
+		if !b.allow(packet(seq), 1250, now) {
+			t.Fatalf("new packet %d was not sent", seq)
+		}
+	}
+
+	// RTX packets (another SSRC) count as resends
+	b.tokens = 0
+	if b.allow(&rtp.Header{SSRC: 2, SequenceNumber: 9}, 1250, now) {
+		t.Fatal("an RTX packet beyond the budget was sent")
+	}
+}
