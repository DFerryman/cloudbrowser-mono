+// keyframeRequestInterval bounds keyframes sent on request: a viewer repeats its request while it
+// waits, and several viewers may ask at once. A request within the interval is answered when it ends.
+const keyframeRequestInterval = 300 * time.Millisecond
+
+// RequestKeyframe makes the encoder's next frame a keyframe (a viewer lost a frame it cannot do without).
+func (manager *StreamSinkManagerCtx) RequestKeyframe() {
+	if !manager.codec.IsVideo() {
+		return
+	}
+
+	manager.keyframeMu.Lock()
+	defer manager.keyframeMu.Unlock()
+
+	if manager.keyframeScheduled {
+		return
+	}
+
+	wait := keyframeRequestInterval - time.Since(manager.lastKeyframeAt)
+	if wait <= 0 {
+		manager.emitRequestedKeyframeLocked()
+		return
+	}
+
+	manager.keyframeScheduled = true
+	time.AfterFunc(wait, func() {
+		manager.keyframeMu.Lock()
+		defer manager.keyframeMu.Unlock()
+
+		manager.keyframeScheduled = false
+		manager.emitRequestedKeyframeLocked()
+	})
+}
+
+func (manager *StreamSinkManagerCtx) emitRequestedKeyframeLocked() {
+	manager.lastKeyframeAt = time.Now()
+
+	manager.pipelineMu.Lock()
+	defer manager.pipelineMu.Unlock()
+
+	if manager.pipeline != nil {
+		manager.logger.Debug().Msg("keyframe requested by a viewer")
+		manager.pipeline.EmitVideoKeyframe()
+	}
+}
+
