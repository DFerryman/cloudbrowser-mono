+// KeyframeRequester is a stream that can encode its next frame as a keyframe.
+type KeyframeRequester interface {
+	RequestKeyframe()
+}
+
+func (t *Track) requestKeyframe() {
+	t.streamMu.Lock()
+	stream := t.stream
+	paused := t.paused
+	t.streamMu.Unlock()
+
+	if requester, ok := stream.(KeyframeRequester); ok && !paused {
+		requester.RequestKeyframe()
+	}
+}
