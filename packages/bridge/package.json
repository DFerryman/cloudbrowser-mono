{
  "name": "@cloudbrowser/bridge",
  "version": "0.1.0",
  "description": "Pairs a local coding agent (MCP) with a Nevazu cloud browser: screenshots, input and file upload through the session gateway.",
  "private": true,
  "type": "module",
  "bin": { "cloudbrowser-bridge": "./dist/cli.mjs" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.mjs --banner:js=\"#!/usr/bin/env node\" --external:ws",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudbrowser/contracts": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
